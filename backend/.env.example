# Alles hier ist optional: Die Werte lassen sich auch in der Verwaltung unter /admin setzen.
# Was dort gespeichert ist, geht diesen Variablen vor. "Zurücksetzen" in der Verwaltung
# lässt wieder den Wert von hier gelten.

# Notfall-Zugang zur Verwaltung. Das eigentliche Passwort legst du beim ersten Aufruf
# von /admin fest. Vergessen? Hier einen langen Wert eintragen, neu starten, damit anmelden.
ADMIN_KEY=

# Home Assistant
HA_URL=http://homeassistant.local:8123
# Long-Lived Access Token (HA Profil -> Sicherheit)
HA_TOKEN=

# Sprachdienste (nur die, die du nutzen willst)
OPENAI_API_KEY=
XAI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_multilingual_v2

# Spracherkennung: openai
STT_PROVIDER=openai
# STT_MODEL=gpt-4o-mini-transcribe
# STT_LANGUAGE=de

# Sprachmodell: openai | xai | custom (OpenAI-kompatibel, z. B. Ollama oder LM Studio)
LLM_PROVIDER=openai
OPENAI_LLM_MODEL=gpt-4o-mini
XAI_LLM_MODEL=grok-3-mini
# CUSTOM_LLM_URL=http://192.168.1.20:11434/v1
# CUSTOM_LLM_API_KEY=
# CUSTOM_LLM_MODEL=llama3.1

# Sprachausgabe: elevenlabs | openai
TTS_PROVIDER=elevenlabs
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=alloy

# Zusätzliche Anweisungen an den Assistenten, z. B. "Duze mich und antworte kurz."
# ASSISTANT_INSTRUCTIONS=

DB_PATH=/data/hausgeist.db

# Update-Hinweis in der App: neuestes Release dieses GitHub-Repos ("" = aus)
UPDATE_REPO=gottschalkfelix4-source/hausgeist
# Hinter einem Reverse Proxy: dessen IP, damit die echte Client-IP ankommt
# FORWARDED_ALLOW_IPS=192.168.1.5
