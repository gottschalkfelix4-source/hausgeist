# Home Assistant
HA_URL=http://homeassistant.local:8123
# Long-Lived Access Token (HA Profil -> Sicherheit)
HA_TOKEN=

# Passwort fuer die Verwaltung unter /admin (leer oder change-me = gesperrt)
ADMIN_KEY=change-me

# Sprach-Provider (nur die, die du nutzen willst)
OPENAI_API_KEY=
XAI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# stt = openai ; llm = openai | xai ; tts = elevenlabs | openai
STT_PROVIDER=openai
LLM_PROVIDER=openai
TTS_PROVIDER=elevenlabs
OPENAI_LLM_MODEL=gpt-4o-mini
XAI_LLM_MODEL=grok-3-mini
DB_PATH=/data/hausgeist.db

# Update-Hinweis in der App: neuestes Release dieses GitHub-Repos ("" = aus)
UPDATE_REPO=gottschalkfelix4-source/hausgeist
# Hinter einem Reverse Proxy: dessen IP, damit die echte Client-IP ankommt
# FORWARDED_ALLOW_IPS=192.168.1.5
