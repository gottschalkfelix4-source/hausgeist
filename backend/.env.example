# Home Assistant
HA_URL=http://homeassistant.local:8123
# Long-Lived Access Token (HA Profil -> Sicherheit)
HA_TOKEN=

# Admin-Key fuer Verwaltung / Tablet-Registrierung
ADMIN_KEY=change-me

# Sprach-Provider (nur die, die du nutzen willst)
OPENAI_API_KEY=
XAI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# stt = openai ; llm = openai | xai ; tts = elevenlabs | openai
STT_PROVIDER=openai
LLM_PROVIDER=openai
TTS_PROVIDER=elevenlabs
OPENAI_LLM_MODEL=gpt-4o-mini
XAI_LLM_MODEL=grok-3-mini
DB_PATH=/data/hausgeist.db
